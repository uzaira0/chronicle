<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Amazon builds ship the minimal collector set: no restricted collectors. -->
    <uses-permission
        android:name="android.permission.ACTIVITY_RECOGNITION"
        tools:node="remove" />

    <application>
        <activity
            android:name="com.openlattice.chronicle.services.notifications.NotificationPermissionActivity"
            tools:node="remove" />
        <receiver
            android:name=".receivers.lifecycle.LockedBootReceiver"
            tools:node="remove"
            tools:ignore="MissingClass" />
        <service
            android:name=".services.sensors.HardwareSensorService"
            tools:node="remove"
            tools:ignore="MissingClass" />
        <service
            android:name=".services.notifications.NotificationListener"
            tools:node="remove"
            tools:ignore="MissingClass" />
        <service
            android:name=".collection.interaction.InteractionCollectionService"
            tools:node="remove"
            tools:ignore="MissingClass" />
    </application>
</manifest>
