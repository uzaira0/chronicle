<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overviewScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chronicle_bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingTop="0dp">

    <LinearLayout
        android:id="@+id/overviewContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_horizontal_padding"
        android:paddingTop="32dp"
        android:paddingEnd="@dimen/page_horizontal_padding"
        android:paddingBottom="96dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/page_overview_title"
            android:textAppearance="@style/Chronicle.MetricValue" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/overviewStudyId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Chronicle.Mono" />

            <TextView
                android:id="@+id/overviewParticipantId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="@style/Chronicle.Mono" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_metric_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/last_upload_header"
                android:textAppearance="@style/Chronicle.SectionTitle" />

            <TextView
                android:id="@+id/overviewLastUpload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/Chronicle.Body" />

            <TextView
                android:id="@+id/overviewLatestTimestamp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="@style/Chronicle.Body" />
        </LinearLayout>

        <TextView
            android:id="@+id/overviewCollectionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_panel"
            android:padding="16dp"
            android:textAppearance="@style/Chronicle.Body" />

        <TextView
            android:id="@+id/overviewServerHealth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_panel"
            android:padding="16dp"
            android:textAppearance="@style/Chronicle.Body" />
    </LinearLayout>
</ScrollView>
