<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overviewScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chronicle_bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingTop="0dp">

    <LinearLayout
        android:id="@+id/overviewContent"
        style="@style/Chronicle.Content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_horizontal_padding"
        android:paddingTop="@dimen/eq_space_6"
        android:paddingEnd="@dimen/page_horizontal_padding"
        android:paddingBottom="@dimen/chronicle_bottom_clearance">

        <TextView android:accessibilityHeading="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/page_overview_title"
            android:textAppearance="@style/Chronicle.MetricValue" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eq_space_4"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="@dimen/eq_space_4">

            <TextView
                android:id="@+id/overviewStudyId"
            android:text="@string/dashboard_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Chronicle.Mono" />

            <TextView
                android:id="@+id/overviewParticipantId"
            android:text="@string/dashboard_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/eq_space_3"
                android:textAppearance="@style/Chronicle.Mono" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eq_space_3"
            android:background="@drawable/bg_metric_panel"
            android:orientation="vertical"
            android:padding="@dimen/eq_space_4">

            <TextView android:accessibilityHeading="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/last_upload_header"
                android:textAppearance="@style/Chronicle.SectionTitle" />

            <TextView
                android:id="@+id/overviewLastUpload"
            android:text="@string/dashboard_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/eq_space_2"
                android:textAppearance="@style/Chronicle.Body" />

            <TextView
                android:id="@+id/overviewLatestTimestamp"
            android:text="@string/dashboard_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/eq_space_3"
                android:textAppearance="@style/Chronicle.Body" />
        </LinearLayout>

        <TextView
            android:id="@+id/overviewCollectionStatus"
            android:text="@string/dashboard_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eq_space_3"
            android:background="@drawable/bg_panel"
            android:padding="@dimen/eq_space_4"
            android:textAppearance="@style/Chronicle.Body" />

        <TextView
            android:id="@+id/overviewServerHealth"
            android:text="@string/dashboard_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eq_space_3"
            android:background="@drawable/bg_panel"
            android:padding="@dimen/eq_space_4"
            android:textAppearance="@style/Chronicle.Body" />
    </LinearLayout>
</ScrollView>
