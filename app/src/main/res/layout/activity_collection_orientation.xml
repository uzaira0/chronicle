<?xml version="1.0" encoding="utf-8"?>
<!--
  Enrollment orientation wizard (per-module consent design §6). One screen per study-enabled
  consent-gated module, shown required-first then optional. The participant Accepts or Declines
  each. Declining a required module blocks enrollment; declining an optional module is
  mistap-confirmed, then proceeds (declined = not collected). Bound dynamically per step by
  CollectionOrientationActivity; copy comes from CollectionConsentCopy templates. Final consent
  wording remains the study/IRB's responsibility.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/orientationRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:paddingTop="?attr/actionBarSize">

    <ScrollView
        android:id="@+id/orientationScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/orientationContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/orientationStep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:alpha="0.7"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/orientationBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/orientationRequirementDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:paddingBottom="16dp" />

            <TextView
                android:id="@+id/orientationRequirementSummaryHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/orientationRequirementSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:alpha="0.82"
                android:paddingBottom="16dp" />

            <TextView
                android:id="@+id/orientationTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:textStyle="bold"
                android:paddingBottom="16dp" />

            <TextView
                android:id="@+id/orientationCollectsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/orientation_collects_header"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/orientationCollects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:paddingBottom="16dp" />

            <TextView
                android:id="@+id/orientationNotCollectHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/orientation_not_collects_header"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/orientationNotCollect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:paddingBottom="16dp" />

            <TextView
                android:id="@+id/orientationCaveat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/colorError"
                android:visibility="gone"
                android:paddingBottom="16dp" />

            <TextView
                android:id="@+id/orientationPrivacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:alpha="0.8"
                android:paddingBottom="24dp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/orientationActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/orientationAccept"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:minHeight="56dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/allow" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/orientationDecline"
            style="@style/Chronicle.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:minHeight="56dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginTop="12dp"
            android:text="@string/dont_allow" />
    </LinearLayout>
</LinearLayout>
