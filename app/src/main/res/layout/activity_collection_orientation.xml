<?xml version="1.0" encoding="utf-8"?>
<!--
  Enrollment orientation wizard (per-module consent design §6). One screen per study-enabled
  consent-gated module, shown required-first then optional. The participant Accepts or Declines
  each. Declining a required module blocks enrollment; declining an optional module is
  mistap-confirmed, then proceeds (declined = not collected). Bound dynamically per step by
  CollectionOrientationActivity; copy comes from the consent_copy.xml resources. Final consent
  wording remains the study/IRB's responsibility.
  Each fact once: "1 of 2 · Optional", the data type's name, what it collects and never collects,
  one line on what declining means. The whole step fits a 1080x2400 phone at the default font
  size for every data type (OrientationOnePageTest); larger fonts scroll.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/orientationRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/orientationScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/orientationContent"
            style="@style/Chronicle.Content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/eq_space_4"
            android:paddingTop="@dimen/eq_space_4"
            android:paddingEnd="@dimen/eq_space_4"
            android:paddingBottom="@dimen/eq_space_2">

            <TextView
                android:id="@+id/orientationStep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Chronicle.Caption"
                android:textColor="@color/chronicle_text_primary"
                android:paddingBottom="@dimen/eq_space_1" />

            <TextView android:textColor="@color/chronicle_text_primary"
                android:id="@+id/orientationTitle"
                android:accessibilityHeading="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Chronicle.Title"
                android:textStyle="bold"
                android:paddingBottom="@dimen/eq_space_3" />

            <TextView android:accessibilityHeading="true" android:textColor="@color/chronicle_text_primary"
                android:id="@+id/orientationCollectsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/orientation_collects_header"
                android:textAppearance="@style/Chronicle.SectionTitle"
                android:textStyle="bold"
                android:paddingBottom="@dimen/eq_space_1" />

            <TextView android:textColor="@color/chronicle_text_primary"
                android:id="@+id/orientationCollects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Chronicle.Body"
                android:paddingBottom="@dimen/eq_space_3" />

            <TextView android:accessibilityHeading="true" android:textColor="@color/chronicle_text_primary"
                android:id="@+id/orientationNotCollectHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/orientation_not_collects_header"
                android:textAppearance="@style/Chronicle.SectionTitle"
                android:textStyle="bold"
                android:paddingBottom="@dimen/eq_space_1" />

            <TextView android:textColor="@color/chronicle_text_primary"
                android:id="@+id/orientationNotCollect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Chronicle.Body"
                android:paddingBottom="@dimen/eq_space_3" />

            <TextView
                android:id="@+id/orientationCaveat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Chronicle.Body"
                android:textStyle="bold"
                android:textColor="?attr/colorError"
                android:visibility="gone"
                android:paddingBottom="@dimen/eq_space_3" />

            <TextView android:textColor="@color/chronicle_text_primary"
                android:id="@+id/orientationRequirementDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Chronicle.Body"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/orientationActions"
        style="@style/Chronicle.Content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/eq_space_4"
        android:paddingTop="@dimen/eq_space_2"
        android:paddingEnd="@dimen/eq_space_4"
        android:paddingBottom="@dimen/eq_space_3">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/orientationAccept"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/chronicle_touch_target_large"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/allow" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/orientationDecline"
            style="@style/Chronicle.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/chronicle_touch_target_large"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginTop="@dimen/eq_space_2"
            android:text="@string/dont_allow" />
    </LinearLayout>
</LinearLayout>
