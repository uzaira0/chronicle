<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/serverEnrollmentScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/serverEnrollmentContent"
        style="@style/Chronicle.Content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_horizontal_padding"
        android:paddingTop="@dimen/eq_space_6"
        android:paddingEnd="@dimen/page_horizontal_padding"
        android:paddingBottom="@dimen/chronicle_bottom_clearance">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/server_name_hint"
            style="@style/Chronicle.Input"
            app:errorEnabled="true"
            android:layout_marginBottom="@dimen/eq_space_2">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/serverNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/server_url_hint"
            style="@style/Chronicle.Input"
            app:errorEnabled="true"
            android:layout_marginBottom="@dimen/eq_space_2">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/serverUrlText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/server_study_id_hint"
            style="@style/Chronicle.Input"
            app:errorEnabled="true"
            android:layout_marginBottom="@dimen/eq_space_2">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/serverStudyIdText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/server_participant_id_hint"
            style="@style/Chronicle.Input"
            app:errorEnabled="true"
            android:layout_marginBottom="@dimen/eq_space_4">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/serverParticipantIdText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>



        <LinearLayout
            android:id="@+id/statsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/eq_space_4"
            android:padding="@dimen/eq_space_3"
            android:background="@drawable/server_stats_background"
            android:visibility="gone">

            <TextView
                android:id="@+id/statsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Chronicle.Mono" />
        </LinearLayout>


        <TextView android:accessibilityHeading="true" android:accessibilityLiveRegion="polite"
            android:id="@+id/serverStatusMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:textAppearance="@style/Chronicle.SectionTitle"
            android:visibility="invisible"
            android:layout_marginBottom="@dimen/eq_space_4" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/serverDeleteButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/server_delete"
            android:backgroundTint="@color/eq_danger_bg"
            android:textColor="@color/eq_danger"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
