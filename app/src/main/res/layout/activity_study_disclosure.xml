<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        style="@style/Chronicle.Content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/eq_space_5">

        <TextView android:accessibilityHeading="true"
            android:id="@+id/studyDisclosureHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/disclosure_before_you_join"
            android:textAppearance="@style/Chronicle.Title" />

        <TextView android:accessibilityHeading="true"
            android:id="@+id/studyDisclosureTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eq_space_3"
            android:textAppearance="@style/Chronicle.SectionTitle" />

        <TextView
            android:id="@+id/studyDisclosureBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eq_space_4"
            android:lineSpacingExtra="@dimen/eq_space_1"
            android:textIsSelectable="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/studyPrivacyButton"
            style="@style/Chronicle.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/disclosure_privacy_policy" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/studyConsentDocumentButton"
            style="@style/Chronicle.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/disclosure_full_consent"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/studyWithdrawalButton"
            style="@style/Chronicle.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/study_withdrawal_options"
            android:visibility="gone" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/studyEligibilityAttestation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/chronicle_touch_target"
            android:textColor="@color/eq_ink"
            android:text="@string/disclosure_eligibility_attestation" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/acceptStudyDisclosureButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eq_space_4"
            android:text="@string/disclosure_agree" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/declineStudyDisclosureButton"
            style="@style/Chronicle.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/disclosure_cancel" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
