<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/localStoreRecoveryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chronicle_bg"
    android:fillViewport="true">

    <LinearLayout
        style="@style/Chronicle.Content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_horizontal_padding"
        android:paddingTop="@dimen/eq_space_7"
        android:paddingEnd="@dimen/page_horizontal_padding"
        android:paddingBottom="@dimen/eq_space_7">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recovery_title"
        android:accessibilityHeading="true"
            android:textAppearance="@style/Chronicle.MetricValue" />

        <TextView
            android:id="@+id/localStoreRecoveryReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eq_space_5"
            android:background="@drawable/bg_panel"
            android:padding="@dimen/eq_space_4"
            android:textAppearance="@style/Chronicle.Body" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eq_space_4"
            android:text="@string/recovery_body"
            android:textAppearance="@style/Chronicle.Body" />

        <ProgressBar
            android:id="@+id/localStoreRecoveryProgress"
            style="@style/ProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/eq_space_5"
            android:visibility="gone" />

        <TextView
            android:id="@+id/localStoreRecoveryStatus"
        android:accessibilityLiveRegion="polite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eq_space_4"
            android:textAppearance="@style/Chronicle.Body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/localStoreRecoveryReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eq_space_5"
            android:text="@string/recovery_reset_action" />
    </LinearLayout>
</ScrollView>
