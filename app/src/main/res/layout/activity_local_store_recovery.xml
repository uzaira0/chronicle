<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/localStoreRecoveryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chronicle_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_horizontal_padding"
        android:paddingTop="48dp"
        android:paddingEnd="@dimen/page_horizontal_padding"
        android:paddingBottom="48dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recovery_title"
            android:textAppearance="@style/Chronicle.MetricValue" />

        <TextView
            android:id="@+id/localStoreRecoveryReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_panel"
            android:padding="16dp"
            android:textAppearance="@style/Chronicle.Body" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/recovery_body"
            android:textAppearance="@style/Chronicle.Body" />

        <ProgressBar
            android:id="@+id/localStoreRecoveryProgress"
            style="@style/ProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/localStoreRecoveryStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="@style/Chronicle.Body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/localStoreRecoveryReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/recovery_reset_action" />
    </LinearLayout>
</ScrollView>
