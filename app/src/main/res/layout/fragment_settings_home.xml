<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsHomeScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chronicle_bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingTop="0dp">

    <LinearLayout
        android:id="@+id/settingsHomeContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_horizontal_padding"
        android:paddingTop="32dp"
        android:paddingEnd="@dimen/page_horizontal_padding"
        android:paddingBottom="96dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/page_settings_title"
            android:textAppearance="@style/Chronicle.MetricValue" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/identifyUserSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_panel"
            android:minHeight="56dp"
            android:padding="16dp"
            android:text="@string/settings_identify_device_user"
            android:textColor="@color/chronicle_text_primary" />

        <TextView
            android:id="@+id/identifyUserStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_panel"
            android:padding="12dp"
            android:textAppearance="@style/Chronicle.Body"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/deviceUserGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_panel"
            android:padding="8dp"
            app:singleSelection="true"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/deviceUserUnset"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/user_unassigned" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/deviceUserChild"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/user_target_child" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/deviceUserOther"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/user_other" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/notificationAccessSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_panel"
            android:minHeight="56dp"
            android:padding="16dp"
            android:text="@string/notification_access"
            android:textColor="@color/chronicle_text_primary" />

        <TextView
            android:id="@+id/settingsServerSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_panel"
            android:padding="16dp"
            android:textAppearance="@style/Chronicle.Body" />

        <LinearLayout
            android:id="@+id/settingsServerList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openServerSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_study_server_details" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addServerSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_add_upload_server" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/studyPrivacyPolicyButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_active_privacy_policy"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/privacyPolicyButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_bcm_compliance" />
    </LinearLayout>
</ScrollView>
