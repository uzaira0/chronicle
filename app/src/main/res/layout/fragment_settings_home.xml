<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsHomeScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chronicle_bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingTop="0dp">

    <LinearLayout
        android:id="@+id/settingsHomeContent"
        style="@style/Chronicle.Content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_horizontal_padding"
        android:paddingTop="@dimen/eq_space_6"
        android:paddingEnd="@dimen/page_horizontal_padding"
        android:paddingBottom="@dimen/chronicle_bottom_clearance">

        <TextView android:accessibilityHeading="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/page_settings_title"
            android:textAppearance="@style/Chronicle.MetricValue" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/identifyUserSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eq_space_4"
            android:background="@drawable/bg_panel"
            android:minHeight="@dimen/chronicle_touch_target_large"
            android:padding="@dimen/eq_space_4"
            android:text="@string/settings_identify_device_user"
            android:textColor="@color/chronicle_text_primary" />

        <TextView
            android:id="@+id/identifyUserStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eq_space_2"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_panel"
            android:padding="@dimen/eq_space_3"
            android:textAppearance="@style/Chronicle.Body"
            android:visibility="gone" />

        <TextView
            android:id="@+id/surveyNotificationStatus"
            android:layout_marginTop="@dimen/eq_space_2"
            android:background="@drawable/bg_panel"
            android:padding="@dimen/eq_space_3"
            android:textAppearance="@style/Chronicle.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/surveyNotificationSettingsButton"
            style="@style/Chronicle.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/chronicle_touch_target_large"
            android:text="@string/settings_survey_notifications"
            android:visibility="gone" />
        <TextView
            android:id="@+id/backgroundAccessStatus"
            android:layout_marginTop="@dimen/eq_space_2"
            android:background="@drawable/bg_panel"
            android:padding="@dimen/eq_space_3"
            android:textAppearance="@style/Chronicle.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/batterySettingsButton"
            style="@style/Chronicle.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/chronicle_touch_target_large"
            android:text="@string/battery_optimization_header"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/oemSettingsButton"
            style="@style/Chronicle.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/chronicle_touch_target_large"
            android:text="@string/oem_background_guidance_title"
            android:visibility="gone" />

        <!-- Shown while notifications are off or the prompt channel no longer pops on screen;
             opens the exact system page that fixes it (app page or channel page). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/identifyUserNotificationSettingsButton"
            style="@style/Chronicle.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eq_space_2"
            android:minHeight="@dimen/chronicle_touch_target_large"
            android:text="@string/settings_open_notification_settings"
            android:visibility="gone" />

        <!-- One full-width choice per row, 16dp apart: a side-by-side row cut "Study participant"
             off on ordinary phones and put three small targets next to each other. -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/deviceUserGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eq_space_3"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="@dimen/eq_space_2"
            android:spacing="@dimen/eq_space_4"
            app:singleSelection="true"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/deviceUserUnset"
                style="@style/Chronicle.Button.Secondary"
                app:icon="@drawable/device_user_check"
                app:iconTint="@color/eq_ink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/chronicle_touch_target_large"
                android:text="@string/user_unassigned_label" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/deviceUserParticipant"
                style="@style/Chronicle.Button.Secondary"
                app:icon="@drawable/device_user_check"
                app:iconTint="@color/eq_ink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/chronicle_touch_target_large"
                android:text="@string/user_study_participant_label" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/deviceUserSomeoneElse"
                style="@style/Chronicle.Button.Secondary"
                app:icon="@drawable/device_user_check"
                app:iconTint="@color/eq_ink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/chronicle_touch_target_large"
                android:text="@string/user_someone_else_label" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/notificationAccessSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eq_space_3"
            android:background="@drawable/bg_panel"
            android:minHeight="@dimen/chronicle_touch_target_large"
            android:padding="@dimen/eq_space_4"
            android:text="@string/notification_access"
            android:textColor="@color/chronicle_text_primary" />

        <TextView
            android:id="@+id/settingsServerSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eq_space_3"
            android:background="@drawable/bg_panel"
            android:padding="@dimen/eq_space_4"
            android:text="@string/dashboard_loading"
            android:textAppearance="@style/Chronicle.Body" />

        <LinearLayout
            android:id="@+id/settingsServerList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eq_space_3"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openServerSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eq_space_3"
            android:text="@string/settings_study_server_details" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/studyPrivacyPolicyButton"
            style="@style/Chronicle.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eq_space_2"
            android:text="@string/settings_active_privacy_policy"
            android:visibility="gone" />

        <TextView android:id="@+id/studyPolicyEffectiveAt"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/chronicle_text_primary" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/studyWithdrawalSettingsButton"
            style="@style/Chronicle.Button.Text"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/study_withdrawal_options" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/reminderTimingButton"
            style="@style/Chronicle.Button.Text"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/reminder_timing_title" android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/privacyPolicyButton"
            style="@style/Chronicle.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eq_space_2"
            android:text="@string/platform_policy_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openSourceLicensesButton"
            style="@style/Chronicle.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_open_source_licenses" />
    </LinearLayout>
</ScrollView>
