<?xml version="1.0" encoding="utf-8"?>
<!--
  This activity is opened from a notification and must remain usable on compact phones,
  tablets, landscape windows, and with enlarged text. Keep the decisions in a vertical,
  content-sized flow and retain the scrolling fallback rather than returning to a fixed row.
  Both decisions share one width (the widest of prompt/labels, content is wrap_content) and sit
  32dp apart so a hurried tap cannot land on the wrong one.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/user_identification_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    tools:context=".UserIdentificationActivity">

    <LinearLayout
        android:id="@+id/user_identification_content"
        android:layout_width="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_horizontal_padding"
        android:paddingTop="@dimen/eq_space_5"
        android:paddingEnd="@dimen/page_horizontal_padding"
        android:paddingBottom="@dimen/eq_space_5">

        <TextView
            android:id="@+id/select_user_prompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:maxWidth="@dimen/chronicle_title_max_width"
            android:text="@string/select_current_user_prompt"
            android:textAppearance="@style/Chronicle.Title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/participant_user_btn"
            style="@style/Chronicle.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eq_space_6"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxWidth="@dimen/chronicle_text_max_width"
            android:minHeight="@dimen/chronicle_touch_target_large"
            android:text="@string/user_study_participant_label"
            app:icon="@drawable/star"
            app:iconSize="@dimen/chronicle_identification_icon_size"
            app:iconTint="@null" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/someone_else_user_btn"
            style="@style/Chronicle.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eq_space_6"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxWidth="@dimen/chronicle_text_max_width"
            android:minHeight="@dimen/chronicle_touch_target_large"
            android:text="@string/user_someone_else_label" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
